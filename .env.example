# Copy to .env and fill in locally. Never commit .env.
# All values are intentionally empty. See docs/02-technical-requirements.md §8.

# --- Jev ---
# Read through app/core/settings.py from the process environment only (JevClient never reads .env):
# export it before starting the app or CLI. TRD §8 names this TYPESAFE_API_KEY; the code uses JEVSTATION_API_KEY.
JEVSTATION_API_KEY=
# Listed in TRD §8; NOT read by the current client (base URL and model are passed as arguments).
TYPESAFE_BASE_URL=
# Pin a version, e.g. jev-<major>.<minor>.<patch>. Not read by the current client.
JEV_MODEL=

# --- Model providers ---
AI_GATEWAY_API_KEY=
GITHUB_TOKEN=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# --- Storage ---
# Note: app/core/settings.py reads DATABASE_URL and REDIS_URL from process environment variables
# only; it does not load them from .env. Until .env loading is deliberately added, export them in
# your shell for local runs (Vercel and CI set them as environment variables).
# Format: postgresql+psycopg://<user>:<password>@localhost:5432/<db>  (Neon pooled URL in prod)
DATABASE_URL=
# Format: redis://localhost:6379/0 locally; rediss://... (Upstash) in prod
REDIS_URL=

# --- Local docker-compose Postgres (docker-compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Routing / limits (TRD §8 lists defaults; set them here locally) ---
CONFIDENCE_THRESHOLD=
CACHE_TTL_SECONDS=
RATE_LIMIT_PER_MIN=
# Trusted header holding the client IP (x-real-ip on Vercel, which overwrites it). Unset = socket peer.
CLIENT_IP_HEADER=
# Secret HMAC key for rate-limit identities (raw IPs are never stored). Unset = rate limit off (fails open).
RATE_LIMIT_IP_SALT=
STRONG_DAILY_CAP=
REQUEST_BUDGET_SECONDS=
# Whole-call limit for each Jev request (default 8). Jev time counts against REQUEST_BUDGET_SECONDS.
JEV_TIMEOUT_SECONDS=
# Optional; defaults to config/models.yaml in the repository.
MODELS_CONFIG_PATH=
